# =============================================================================
# Rxify — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env to version control.

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# Required. Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Create the DB first: psql -U postgres -c "CREATE DATABASE rxify;"
DATABASE_URL=postgresql://postgres:password@localhost:5432/rxify

# ── Google Gemini API ─────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here   # alternative — either one works

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_key_minimum_32_characters_long

# ── Optional Tuning ───────────────────────────────────────────────────────────
# ACCESS_TOKEN_EXPIRE_MINUTES=30
